meta {
  name: search
  type: http
  seq: 1
}

post {
  url: {{publication_api_dev}}/search
  body: json
  auth: inherit
}

body:json {
  {
    "publication_id": "david-copperfield",
    "query": "happy",
    "max_results": 10,
    "context_chars": 100
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Basic full-text search. Search uses the English analyzer with Porter
  stemming, so "happy" also matches "happiness" / "happily". Results are
  ranked by BM25 score (highest first), not document order.
}
