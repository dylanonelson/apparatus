{
  "folders": [
    {
      "path": "reader_api",
      "name": "Reader API (Python)"
    },
    {
      "path": "frontend",
      "name": "Web client (Next.js)"
    },
    {
      "path": "publication_api",
      "name": "Publication API (Go)"
    },
    {
      "path": "evals",
      "name": "Evals"
    },
    {
      "path": ".",
      "name": "Root"
    }
  ],
  "settings": {
    // Global settings across all folders
    "files.exclude": {
      "**/__pycache__": true,
      "**/*.pyc": true,
      "**/.DS_Store": true,
    },
    // We have to set this globally because the Python extension doesn't support
    // workspace-specific interpreters
    "ruff.interpreter": ["${workspaceFolder}/reader_api/.venv/bin/python"]
  }
}
